{
  "name": "football-trivia",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "vite dev",
    "build": "tsc --noEmit && vite build",
    "preview": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "seed:build": "node scripts/build-seed.mjs",
    "db:migrate:local": "wrangler d1 migrations apply football-iq-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply football-iq-db --remote",
    "db:apply": "node scripts/seed-apply.mjs",
    "db:apply:remote": "node scripts/seed-apply.mjs --remote",
    "d1:write-plan": "node scripts/seed-apply.mjs --dry-run",
    "d1:write-plan:remote": "node scripts/seed-apply.mjs --remote --dry-run",
    "db:bootstrap:local": "wrangler d1 execute football-iq-db --local --file=seed/seed.sql",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "test": "node --test \"tests/**/*.test.ts\"",
    "qa:reliability": "node scripts/reliability-qa.mjs",
    "qa:security": "node scripts/security-qa.mjs",
    "qa:product": "node scripts/product-qa.mjs",
    "qa:stability": "node scripts/stability-qa.mjs",
    "qa:concurrency": "node scripts/concurrency-qa.mjs",
    "qa:load": "node scripts/load-qa.mjs",
    "qa:straddle:before": "node scripts/deploy-straddle-qa.mjs --phase=before",
    "qa:straddle:after": "node scripts/deploy-straddle-qa.mjs --phase=after",
    "qa:prod": "node scripts/security-qa.mjs && node scripts/product-qa.mjs && node scripts/reliability-qa.mjs --engine=chromium && node scripts/stability-qa.mjs && node scripts/concurrency-qa.mjs && node scripts/load-qa.mjs",
    "test:mp": "node scripts/mp-e2e.mjs",
    "test:mp:browser": "node scripts/mp-browser.mjs",
    "test:mp:prod": "node scripts/mp-e2e.mjs https://football-iq.naorl.workers.dev",
    "data:harvest": "node scripts/data-harvest.mjs",
    "data:status": "node scripts/data-status.mjs",
    "questions:generate": "node scripts/questions-generate.mjs",
    "questions:generate:incremental": "node scripts/questions-generate.mjs",
    "questions:stats": "node scripts/questions-stats.mjs",
    "questions:audit": "node scripts/questions-audit.mjs",
    "questions:audit:remote": "node scripts/questions-audit.mjs --remote",
    "questions:repair:remote": "node scripts/questions-audit.mjs --remote --repair",
    "db:report": "node scripts/d1-report.mjs",
    "db:report:remote": "node scripts/d1-report.mjs --remote",
    "test:mp:entry": "node scripts/mp-entry-qa.mjs",
    "qa:mobile": "node scripts/mobile-matrix-qa.mjs",
    "qa:mobile:all": "node scripts/mobile-matrix-qa.mjs --phase=all --loads=100 --hold=15",
    "qa:builder": "node scripts/builder-qa.mjs",
    "qa:blank": "node scripts/blankscreen-qa.mjs",
    "qa:blank:stress": "node scripts/blank-stress.mjs",
    "app:build": "VITE_API_ORIGIN=${VITE_API_ORIGIN:-https://football-iq.naorl.workers.dev} vite build && cap sync",
    "app:ios": "npm run app:build && cap open ios",
    "app:android": "npm run app:build && cap open android"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Naorl98/football-trivia.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Naorl98/football-trivia/issues"
  },
  "homepage": "https://github.com/Naorl98/football-trivia#readme",
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "hono": "^4.13.11",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@cloudflare/vite-plugin": "^1.62.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "wrangler": "^4.143.1"
  }
}
